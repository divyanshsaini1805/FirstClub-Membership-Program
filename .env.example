# Copy to .env and adjust as needed.
# Used by docker-compose for variable substitution.

# Host port to publish the app on (container internal stays 8080).
# Override if you already have something on 8080 (e.g. APP_PORT=8090).
APP_PORT=8080

# JWT signing secret (HS256). Minimum 32 bytes for production.
JWT_SECRET=change-me-this-is-a-demo-secret-replace-in-prod-please-32bytes-min

# Seed balance credited on user registration. Comfortably covers any tier.
WALLET_SIGNUP_BONUS=50000.00
